<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_mint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/practice_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="返回"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/home_ink"
            android:textSize="36sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/practice_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="综合练习"
            android:textColor="@color/home_ink"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/practice_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:textColor="@color/home_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/practice_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressTint="@color/home_accent_dark"
        android:progressBackgroundTint="#DDECE8" />

    <TextView
        android:id="@+id/practice_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:lineSpacingExtra="4dp"
        android:text="题库为空，暂时没有可练习的题目。"
        android:textColor="@color/home_ink"
        android:textSize="17sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/practice_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="42dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/practice_stem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="7dp"
                android:textColor="@color/home_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/practice_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/option_a"
                    style="@style/PracticeOption" />

                <RadioButton
                    android:id="@+id/option_b"
                    style="@style/PracticeOption" />

                <RadioButton
                    android:id="@+id/option_c"
                    style="@style/PracticeOption" />

                <RadioButton
                    android:id="@+id/option_d"
                    style="@style/PracticeOption" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/practice_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/practice_prev"
                style="@style/PracticeSecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="上一题" />

            <TextView
                android:id="@+id/practice_next"
                style="@style/PracticeSecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="下一题" />
        </LinearLayout>

        <TextView
            android:id="@+id/practice_submit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_cta"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="提交并查看成绩"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
