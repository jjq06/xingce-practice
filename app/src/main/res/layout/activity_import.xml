<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/import_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="导入题库" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="16sp"
            android:text="使用 UTF-8 编码的 .txt 文件，每行一道单选题。字段用真正的 Tab 制表符分隔，不能用空格代替。" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textStyle="bold" android:text="八列顺序" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="类别 → 题干 → 选项A → 选项B → 选项C → 选项D → 答案 → 解析\n答案为 A、B、C、D；解析可为空，末尾的 Tab 仍须保留。" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="导入会自动跳过重复题，并保留原题和历史记录。只解析规定模板，不支持 PDF 或 Word。" />
        <Button android:id="@+id/pick_file" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="选择 UTF-8 TXT 文件" />
        <ProgressBar android:id="@+id/import_progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:visibility="gone" android:contentDescription="正在导入" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textStyle="bold" android:text="导入结果" />
        <TextView android:id="@+id/import_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp"
            android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
