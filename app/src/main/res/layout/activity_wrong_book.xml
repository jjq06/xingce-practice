<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="错题本" android:textSize="24sp" android:textStyle="bold" />

        <TextView android:id="@+id/page_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="正在读取错题…" />
        <Button android:id="@+id/retry_wrong" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="重练错题" android:enabled="false" />
        <LinearLayout android:id="@+id/wrong_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
